SELECT product_id, SUM(product_id) OVER w AS total, ROW_NUMBER() OVER (w ORDER BY product_id) AS rn
FROM shop.product
WINDOW w AS (PARTITION BY parent_id);
SELECT product_id, LAG(name) OVER byid AS previous, COUNT(*) OVER running AS n
FROM shop.product
WINDOW byid AS (ORDER BY product_id), running AS (byid ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW);
