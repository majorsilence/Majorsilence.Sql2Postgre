CREATE TABLE dbo.item (id int IDENTITY NOT NULL PRIMARY KEY, name nvarchar(50) NOT NULL, price decimal(10, 2) NOT NULL);
GO
CREATE TABLE dbo.price_history (id int IDENTITY NOT NULL PRIMARY KEY, item_id int NOT NULL, old_price decimal(10, 2) NULL, new_price decimal(10, 2) NULL);
GO
CREATE VIEW dbo.cheap_item AS SELECT id, name, price FROM dbo.item WHERE price < 5;
GO
CREATE TRIGGER dbo.item_prices ON dbo.item AFTER INSERT, UPDATE, DELETE AS
BEGIN
    IF @@ROWCOUNT = 0
        RETURN;
    SET NOCOUNT ON;
    IF UPDATE(price) OR NOT EXISTS (SELECT 1 FROM deleted)
        INSERT INTO dbo.price_history (item_id, old_price, new_price)
        SELECT COALESCE(i.id, d.id), d.price, i.price
        FROM inserted AS i FULL JOIN deleted AS d ON d.id = i.id;
END;
GO
CREATE TRIGGER dbo.item_no_negative ON dbo.item FOR INSERT AS
BEGIN
    IF EXISTS (SELECT 1 FROM inserted WHERE price < 0)
    BEGIN
        RAISERROR (N'negative price', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END;
END;
GO
CREATE TRIGGER dbo.cheap_item_insert ON dbo.cheap_item INSTEAD OF INSERT AS
    INSERT INTO dbo.item (name, price) SELECT name, price FROM inserted WHERE price < 5;
GO
CREATE TRIGGER dbo.item_instead ON dbo.item INSTEAD OF DELETE AS
    UPDATE dbo.item SET price = 0 WHERE id IN (SELECT id FROM deleted);
GO
CREATE TRIGGER dbo.history_columns ON dbo.price_history AFTER UPDATE AS
    IF COLUMNS_UPDATED() & 4 = 4 PRINT N'new_price changed';
GO
