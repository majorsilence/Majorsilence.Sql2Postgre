-- sql2pg: phase Schemas

-- sql2pg:object Extension pg_trgm status=Converted
CREATE EXTENSION IF NOT EXISTS pg_trgm;

-- sql2pg: phase Tables

-- sql2pg:object Table public.item status=Converted
CREATE TABLE public.item (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    name varchar(50) NOT NULL,
    price numeric(10,2) NOT NULL
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.count_cheaper status=Converted
CREATE PROCEDURE public.count_cheaper(max numeric(10,2), INOUT count integer DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'SELECT @n = COUNT(*) FROM dbo.item WHERE price <= @limit';
    EXECUTE 'SELECT count(*)
FROM public.item
WHERE price <= $1' INTO count_cheaper.count USING count_cheaper.max, count_cheaper.count;
END;
$$;

-- sql2pg:object Procedure public.count_rows status=Converted
CREATE PROCEDURE public.count_rows(schema varchar(128), "table" varchar(128), INOUT count integer DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'SELECT @n = COUNT(*) FROM ' || '[' || replace(count_rows.schema, ']', ']]') || ']' || '.' || '[' || replace(count_rows."table", ']', ']]') || ']';
    EXECUTE format('SELECT count(*)
FROM %1$I.%2$I', CASE lower(count_rows.schema) WHEN 'dbo' THEN 'public' ELSE lower(count_rows.schema) END, lower(count_rows."table")) INTO count_rows.count USING count_rows.count;
END;
$$;

-- sql2pg:object Procedure public.dynamic_ddl status=Manual
CREATE PROCEDURE public.dynamic_ddl("table" varchar(128))
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'DROP TABLE ' || '[' || replace(dynamic_ddl."table", ']', ']]') || ']';
    /* sql2pg:untranslated S2P5060
    EXEC (@sql);
    */
END;
$$;

-- sql2pg:object Procedure public.find status=ConvertedWithWarnings
CREATE PROCEDURE public.find(name varchar(50), top integer, INOUT result_set refcursor DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'SELECT TOP (' || CAST(find.top AS varchar(10)) || ') id, name FROM dbo.item WHERE name = ''' || find.name || ''' ORDER BY id';
    OPEN result_set FOR EXECUTE format('SELECT id, name
FROM public.item
WHERE name = %2$L
ORDER BY id NULLS FIRST
LIMIT %1$s', CAST(find.top AS varchar(10)), find.name);
END;
$$;

-- sql2pg:object Procedure public.touch status=Converted
CREATE PROCEDURE public.touch()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    EXECUTE 'UPDATE public.item
SET price = price
WHERE name LIKE ''%a%''';
END;
$$;

-- sql2pg:object Procedure public.unknown_text status=Manual
CREATE PROCEDURE public.unknown_text(sql text)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    /* sql2pg:untranslated S2P5060
    EXEC (@sql);
    */
END;
$$;

-- sql2pg: phase Indexes

-- sql2pg:object Index public.trgm_item_name status=Converted
CREATE INDEX trgm_item_name ON public.item USING gin (name gin_trgm_ops);

-- sql2pg: phase Constraints

-- sql2pg:object Constraint public.item.item_pkey status=Converted
ALTER TABLE public.item ADD CONSTRAINT item_pkey PRIMARY KEY (id);
