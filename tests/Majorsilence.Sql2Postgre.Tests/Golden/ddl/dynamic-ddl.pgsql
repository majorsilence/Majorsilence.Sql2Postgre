-- sql2pg: phase Sequences

-- sql2pg:object Sequence public.ticket status=Converted
CREATE SEQUENCE public.ticket AS integer START WITH 1 INCREMENT BY 1 MINVALUE -2147483648 MAXVALUE 2147483647 NO CYCLE;

-- sql2pg: phase Tables

-- sql2pg:object Table public.item status=Converted
CREATE TABLE public.item (
    id integer NOT NULL,
    name varchar(50) NOT NULL
);

-- sql2pg:object Table public.itemaudit status=Converted
CREATE TABLE public.itemaudit (
    auditid integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    itemid integer NOT NULL,
    note varchar(100) NOT NULL
);

-- sql2pg:object Table public.sale status=Converted
CREATE TABLE public.sale (
    saleid integer NOT NULL,
    region varchar(10) NOT NULL
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.addaudit status=Converted
CREATE PROCEDURE public.addaudit()
LANGUAGE plpgsql
AS $body$
#variable_conflict use_column
DECLARE
    v_schemaname varchar(128);
    v_tablename varchar(128);
    v_crlf varchar(2);
    v_sql text;
BEGIN
    v_schemaname := 'dbo';
    v_tablename := 'Item';
    v_crlf := CAST(chr(13) || chr(10) AS varchar(2));
    v_sql := 'DROP TRIGGER IF EXISTS ' || '[' || replace(v_schemaname, ']', ']]') || ']' || '.[TR_' || v_tablename || '_Audit];';
    EXECUTE 'DROP TRIGGER IF EXISTS tr_item_audit ON public.item';
    EXECUTE 'DROP ROUTINE IF EXISTS public.tr_item_audit';
    v_sql := 'CREATE TRIGGER ' || '[' || replace(v_schemaname, ']', ']]') || ']' || '.[TR_' || v_tablename || '_Audit]' || v_crlf || 'ON ' || '[' || replace(v_schemaname, ']', ']]') || ']' || '.' || '[' || replace(v_tablename, ']', ']]') || ']' || v_crlf || 'AFTER INSERT' || v_crlf || 'AS' || v_crlf || 'BEGIN' || v_crlf || '    SET NOCOUNT ON;' || v_crlf || '    INSERT dbo.ItemAudit (ItemId, Note) SELECT i.Id, N''added '' + i.Name FROM inserted AS i;' || v_crlf || 'END;';
    EXECUTE 'CREATE FUNCTION public.tr_item_audit()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    INSERT INTO public.itemaudit (itemid, note)
    SELECT i.id, ''added '' || i.name
    FROM inserted AS i;
    RETURN NULL;
END;
$$';
    EXECUTE 'CREATE TRIGGER tr_item_audit AFTER INSERT ON public.item
REFERENCING NEW TABLE AS inserted
FOR EACH STATEMENT
EXECUTE FUNCTION public.tr_item_audit()';
END;
$body$;

-- sql2pg:object Procedure public.applypolicy status=ConvertedWithWarnings
CREATE PROCEDURE public.applypolicy()
LANGUAGE plpgsql
AS $body$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'DROP SECURITY POLICY IF EXISTS dbo.SaleRegion;';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_select ON public.sale';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_insert ON public.sale';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_update ON public.sale';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_delete ON public.sale';
    EXECUTE 'ALTER TABLE public.sale NO FORCE ROW LEVEL SECURITY';
    EXECUTE 'ALTER TABLE public.sale DISABLE ROW LEVEL SECURITY';
    v_sql := 'DROP FUNCTION IF EXISTS dbo.RegionVisible;';
    EXECUTE 'DROP ROUTINE IF EXISTS public.regionvisible';
    v_sql := 'CREATE FUNCTION dbo.RegionVisible(@Region nvarchar(10)) RETURNS TABLE WITH SCHEMABINDING AS RETURN (SELECT 1 AS Visible WHERE @Region = N''north'');';
    EXECUTE 'CREATE FUNCTION public.regionvisible(region varchar(10))
RETURNS TABLE (visible integer)
LANGUAGE sql
IMMUTABLE
AS $$
SELECT 1 AS visible
WHERE regionvisible.region = ''north'';
$$';
    v_sql := 'CREATE SECURITY POLICY dbo.SaleRegion ADD FILTER PREDICATE dbo.RegionVisible(Region) ON dbo.Sale, ADD BLOCK PREDICATE dbo.RegionVisible(Region) ON dbo.Sale AFTER INSERT;';
    EXECUTE 'CREATE POLICY saleregion_select ON public.sale FOR SELECT USING (EXISTS (SELECT 1 FROM public.regionvisible(region)))';
    EXECUTE 'CREATE POLICY saleregion_insert ON public.sale FOR INSERT WITH CHECK (EXISTS (SELECT 1 FROM public.regionvisible(region)))';
    EXECUTE 'CREATE POLICY saleregion_update ON public.sale FOR UPDATE USING (EXISTS (SELECT 1 FROM public.regionvisible(region))) WITH CHECK (true)';
    EXECUTE 'CREATE POLICY saleregion_delete ON public.sale FOR DELETE USING (EXISTS (SELECT 1 FROM public.regionvisible(region)))';
    EXECUTE 'ALTER TABLE public.sale ENABLE ROW LEVEL SECURITY';
    EXECUTE 'ALTER TABLE public.sale FORCE ROW LEVEL SECURITY';
END;
$body$;

-- sql2pg:object Procedure public.makedoubler status=ConvertedWithWarnings
CREATE PROCEDURE public.makedoubler()
LANGUAGE plpgsql
AS $body$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'DROP PROCEDURE IF EXISTS dbo.Doubler;';
    EXECUTE 'DROP ROUTINE IF EXISTS public.doubler';
    v_sql := 'CREATE PROCEDURE dbo.Doubler @x int, @y int OUTPUT AS BEGIN SET @y = @x * 2; END;';
    EXECUTE 'CREATE PROCEDURE public.doubler(x integer, INOUT y integer DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    doubler.y := doubler.x * 2;
END;
$$';
END;
$body$;

-- sql2pg:object Procedure public.removeaudit status=Converted
CREATE PROCEDURE public.removeaudit()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    DROP TRIGGER IF EXISTS tr_item_audit ON public.item;
    DROP ROUTINE IF EXISTS public.tr_item_audit;
END;
$$;

-- sql2pg:object Procedure public.removepolicy status=ConvertedWithWarnings
CREATE PROCEDURE public.removepolicy()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'DROP SECURITY POLICY IF EXISTS dbo.SaleRegion;';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_select ON public.sale';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_insert ON public.sale';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_update ON public.sale';
    EXECUTE 'DROP POLICY IF EXISTS saleregion_delete ON public.sale';
    EXECUTE 'ALTER TABLE public.sale NO FORCE ROW LEVEL SECURITY';
    EXECUTE 'ALTER TABLE public.sale DISABLE ROW LEVEL SECURITY';
    v_sql := 'DROP FUNCTION IF EXISTS dbo.RegionVisible;';
    EXECUTE 'DROP ROUTINE IF EXISTS public.regionvisible';
END;
$$;

-- sql2pg:object Procedure public.reseed status=Converted
CREATE PROCEDURE public.reseed(sequencename varchar(128), next bigint)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_sql text;
BEGIN
    v_sql := 'ALTER SEQUENCE dbo.' || '[' || replace(reseed.sequencename, ']', ']]') || ']' || ' RESTART WITH ' || CAST(reseed.next AS varchar(20)) || ';';
    EXECUTE format('ALTER SEQUENCE public.%1$I RESTART WITH %2$s', lower(reseed.sequencename), CAST(reseed.next AS varchar(20)));
END;
$$;

-- sql2pg:object Procedure public.usedoubler status=Converted
CREATE PROCEDURE public.usedoubler(x integer)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_y integer;
BEGIN
    CALL public.doubler(x => usedoubler.x, y => v_y);
    INSERT INTO public.itemaudit (itemid, note)
    VALUES (usedoubler.x, 'doubled ' || CAST(v_y AS varchar(10)));
END;
$$;

