-- sql2pg: phase Tables

-- sql2pg:object Table public.item status=Converted
CREATE TABLE public.item (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    name varchar(50) NOT NULL,
    price numeric(10,2) NOT NULL
);

-- sql2pg:object Table public.price_history status=Converted
CREATE TABLE public.price_history (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    item_id integer NOT NULL,
    old_price numeric(10,2),
    new_price numeric(10,2)
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object View public.cheap_item status=Converted
CREATE VIEW public.cheap_item AS
SELECT id, name, price
FROM public.item
WHERE price < 5;

-- sql2pg: phase Constraints

-- sql2pg:object Constraint public.item.item_pkey status=Converted
ALTER TABLE public.item ADD CONSTRAINT item_pkey PRIMARY KEY (id);

-- sql2pg:object Constraint public.price_history.price_history_pkey status=Converted
ALTER TABLE public.price_history ADD CONSTRAINT price_history_pkey PRIMARY KEY (id);

-- sql2pg: phase Triggers

-- sql2pg:object Trigger public.cheap_item_insert status=Converted
CREATE FUNCTION public.cheap_item_insert()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    INSERT INTO public.item (name, price)
    SELECT name, price
    FROM (SELECT new.*) AS inserted
    WHERE price < 5;
    RETURN NEW;
END;
$$;
CREATE TRIGGER cheap_item_insert INSTEAD OF INSERT ON public.cheap_item
FOR EACH ROW
EXECUTE FUNCTION public.cheap_item_insert();

-- sql2pg:object Trigger public.history_columns status=Manual
CREATE FUNCTION public.history_columns()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    /* sql2pg:untranslated S2P6002
    IF COLUMNS_UPDATED() & 4 = 4 PRINT N'new_price changed';
    */
    RETURN NULL;
END;
$$;
CREATE TRIGGER history_columns AFTER UPDATE ON public.price_history
REFERENCING NEW TABLE AS inserted OLD TABLE AS deleted
FOR EACH STATEMENT
EXECUTE FUNCTION public.history_columns();

-- sql2pg:object Trigger public.item_instead status=ConvertedWithWarnings
CREATE FUNCTION public.item_instead()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    IF current_setting('sql2pg.instead_of_item_instead', true) = 'on' THEN
        RETURN OLD;
    END IF;
    PERFORM set_config('sql2pg.instead_of_item_instead', 'on', true);
    UPDATE public.item
    SET price = 0
    WHERE id IN (SELECT id FROM (SELECT old.*) AS deleted);
    PERFORM set_config('sql2pg.instead_of_item_instead', '', true);
    RETURN NULL;
END;
$$;
CREATE TRIGGER item_instead BEFORE DELETE ON public.item
FOR EACH ROW
EXECUTE FUNCTION public.item_instead();

-- sql2pg:object Trigger public.item_no_negative status=Converted
CREATE FUNCTION public.item_no_negative()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_rolled_back boolean;
BEGIN
    IF EXISTS (SELECT 1 FROM inserted WHERE price < 0) THEN
        RAISE EXCEPTION 'negative price';
        sql2pg_rolled_back := true;
        IF sql2pg_rolled_back THEN
            RAISE EXCEPTION 'transaction rolled back by trigger %', TG_NAME;
        END IF;
        RETURN NULL;
    END IF;
    IF sql2pg_rolled_back THEN
        RAISE EXCEPTION 'transaction rolled back by trigger %', TG_NAME;
    END IF;
    RETURN NULL;
END;
$$;
CREATE TRIGGER item_no_negative AFTER INSERT ON public.item
REFERENCING NEW TABLE AS inserted
FOR EACH STATEMENT
EXECUTE FUNCTION public.item_no_negative();

-- sql2pg:object Trigger public.item_prices status=ConvertedWithWarnings
CREATE FUNCTION public.item_prices_insert()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_rowcount integer;
BEGIN
    sql2pg_rowcount := CAST((SELECT count(*) FROM inserted) AS integer);
    IF sql2pg_rowcount = 0 THEN
        RETURN NULL;
    END IF;
    sql2pg_rowcount := 0;
    IF true OR NOT EXISTS (SELECT 1 FROM (SELECT * FROM public.item WHERE false) AS deleted) THEN
        INSERT INTO public.price_history (item_id, old_price, new_price)
        SELECT COALESCE(i.id, d.id), d.price, i.price
        FROM inserted AS i FULL JOIN (SELECT * FROM public.item WHERE false) AS d ON d.id = i.id;
        GET DIAGNOSTICS sql2pg_rowcount = ROW_COUNT;
    END IF;
    RETURN NULL;
END;
$$;
CREATE TRIGGER item_prices_insert AFTER INSERT ON public.item
REFERENCING NEW TABLE AS inserted
FOR EACH STATEMENT
EXECUTE FUNCTION public.item_prices_insert();
CREATE FUNCTION public.item_prices_update()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_rowcount integer;
BEGIN
    sql2pg_rowcount := CAST((SELECT count(*) FROM inserted) AS integer);
    IF sql2pg_rowcount = 0 THEN
        RETURN NULL;
    END IF;
    sql2pg_rowcount := 0;
    IF EXISTS (SELECT 1 FROM inserted AS sql2pg_i LEFT JOIN deleted AS sql2pg_d ON sql2pg_d.id = sql2pg_i.id WHERE sql2pg_d.id IS NULL OR sql2pg_i.price IS DISTINCT FROM sql2pg_d.price) OR NOT EXISTS (SELECT 1 FROM deleted) THEN
        INSERT INTO public.price_history (item_id, old_price, new_price)
        SELECT COALESCE(i.id, d.id), d.price, i.price
        FROM inserted AS i FULL JOIN deleted AS d ON d.id = i.id;
        GET DIAGNOSTICS sql2pg_rowcount = ROW_COUNT;
    END IF;
    RETURN NULL;
END;
$$;
CREATE TRIGGER item_prices_update AFTER UPDATE ON public.item
REFERENCING NEW TABLE AS inserted OLD TABLE AS deleted
FOR EACH STATEMENT
EXECUTE FUNCTION public.item_prices_update();
CREATE FUNCTION public.item_prices_delete()
RETURNS trigger
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_rowcount integer;
BEGIN
    sql2pg_rowcount := CAST((SELECT count(*) FROM deleted) AS integer);
    IF sql2pg_rowcount = 0 THEN
        RETURN NULL;
    END IF;
    sql2pg_rowcount := 0;
    IF false OR NOT EXISTS (SELECT 1 FROM deleted) THEN
        INSERT INTO public.price_history (item_id, old_price, new_price)
        SELECT COALESCE(i.id, d.id), d.price, i.price
        FROM (SELECT * FROM public.item WHERE false) AS i FULL JOIN deleted AS d ON d.id = i.id;
        GET DIAGNOSTICS sql2pg_rowcount = ROW_COUNT;
    END IF;
    RETURN NULL;
END;
$$;
CREATE TRIGGER item_prices_delete AFTER DELETE ON public.item
REFERENCING OLD TABLE AS deleted
FOR EACH STATEMENT
EXECUTE FUNCTION public.item_prices_delete();
