-- sql2pg: phase Tables

-- sql2pg:object Table public.item status=Converted
CREATE TABLE public.item (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    name varchar(50) NOT NULL,
    price numeric(10,2) NOT NULL
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.count_with_variable status=Converted
CREATE FUNCTION public.count_with_variable()
RETURNS TABLE (n integer)
LANGUAGE plpgsql
STABLE
AS $$
#variable_conflict use_column
DECLARE
    v_id integer;
    v_n integer;
    sql2pg_fetch1 integer;
    sql2pg_fetch_status integer;
BEGIN
    v_n := 0;
    FOR sql2pg_fetch1 IN SELECT id
        FROM public.item
    LOOP
        v_id := sql2pg_fetch1;
        sql2pg_fetch_status := 0;
        v_n := v_n + 1;
    END LOOP;
    sql2pg_fetch_status := -1;
    RETURN QUERY SELECT CAST(v_n AS integer) AS n;
END;
$$;

-- sql2pg:object Procedure public.discount status=Converted
CREATE PROCEDURE public.discount(percent integer)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_price numeric(10,2);
    cur_c refcursor;
    sql2pg_fetch1 numeric(10,2);
    sql2pg_fetch_status integer;
BEGIN
    OPEN cur_c FOR SELECT price
        FROM public.item
        WHERE price > 10
        FOR UPDATE;
    WHILE 1 = 1 LOOP
        FETCH NEXT FROM cur_c INTO sql2pg_fetch1;
        IF FOUND THEN
            v_price := sql2pg_fetch1;
            sql2pg_fetch_status := 0;
        ELSE
            sql2pg_fetch_status := -1;
        END IF;
        IF sql2pg_fetch_status <> 0 THEN
            EXIT;
        END IF;
        UPDATE public.item
        SET price = v_price * (100 - discount.percent) / 100
        WHERE CURRENT OF cur_c;
    END LOOP;
    CLOSE cur_c;
END;
$$;

-- sql2pg:object Procedure public.ends status=Converted
CREATE FUNCTION public.ends()
RETURNS TABLE (first_id integer, last_id integer, second_last integer, id integer, status integer)
LANGUAGE plpgsql
STABLE
AS $$
#variable_conflict use_column
DECLARE
    v_id integer;
    v_first integer;
    v_last integer;
    v_second_last integer;
    v_status integer;
    cur_ids refcursor;
    sql2pg_fetch1 integer;
    sql2pg_fetch_status integer;
BEGIN
    OPEN cur_ids SCROLL FOR SELECT id
        FROM public.item
        ORDER BY id NULLS FIRST;
    FETCH FIRST FROM cur_ids INTO sql2pg_fetch1;
    IF FOUND THEN
        v_first := sql2pg_fetch1;
        sql2pg_fetch_status := 0;
    ELSE
        sql2pg_fetch_status := -1;
    END IF;
    FETCH LAST FROM cur_ids INTO sql2pg_fetch1;
    IF FOUND THEN
        v_last := sql2pg_fetch1;
        sql2pg_fetch_status := 0;
    ELSE
        sql2pg_fetch_status := -1;
    END IF;
    FETCH PRIOR FROM cur_ids INTO sql2pg_fetch1;
    IF FOUND THEN
        v_second_last := sql2pg_fetch1;
        sql2pg_fetch_status := 0;
    ELSE
        sql2pg_fetch_status := -1;
    END IF;
    FETCH ABSOLUTE 100 FROM cur_ids INTO sql2pg_fetch1;
    IF FOUND THEN
        v_id := sql2pg_fetch1;
        sql2pg_fetch_status := 0;
    ELSE
        sql2pg_fetch_status := -1;
    END IF;
    v_status := sql2pg_fetch_status;
    CLOSE cur_ids;
    RETURN QUERY SELECT CAST(v_first AS integer) AS first_id, CAST(v_last AS integer) AS last_id, CAST(v_second_last AS integer) AS second_last, CAST(v_id AS integer) AS id, CAST(v_status AS integer) AS status;
END;
$$;

