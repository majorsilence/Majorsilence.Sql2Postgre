-- sql2pg:object Procedure public.price_list status=Converted
CREATE FUNCTION public.price_list()
RETURNS TABLE (list text, last_name varchar(50))
LANGUAGE plpgsql
STABLE
AS $$
#variable_conflict use_column
DECLARE
    v_name varchar(50);
    v_price numeric(10,2);
    v_list text;
    sql2pg_fetch1 varchar(50);
    sql2pg_fetch2 numeric(10,2);
    sql2pg_fetch_status integer;
BEGIN
    v_list := '';
    FOR sql2pg_fetch1, sql2pg_fetch2 IN SELECT name, price
        FROM public.item
        ORDER BY name NULLS FIRST
    LOOP
        v_name := sql2pg_fetch1;
        v_price := sql2pg_fetch2;
        sql2pg_fetch_status := 0;
        v_list := v_list || v_name || '=' || CAST(v_price AS varchar(20)) || ';';
    END LOOP;
    sql2pg_fetch_status := -1;
    RETURN QUERY SELECT CAST(v_list AS text) AS list, CAST(v_name AS varchar) AS last_name;
END;
$$;

