CREATE TABLE dbo.Customer (
    Id int NOT NULL PRIMARY KEY,
    Email nvarchar(100) MASKED WITH (FUNCTION = 'email()') NULL,
    Phone varchar(20) MASKED WITH (FUNCTION = 'partial(0,"XXX-",4)') NULL,
    TaxId char(11) COLLATE Latin1_General_BIN2 ENCRYPTED WITH (COLUMN_ENCRYPTION_KEY = CEK1, ENCRYPTION_TYPE = DETERMINISTIC, ALGORITHM = 'AEAD_AES_256_CBC_HMAC_SHA_256') NULL,
    ValidFrom datetime2 GENERATED ALWAYS AS ROW START HIDDEN NOT NULL,
    ValidTo datetime2 GENERATED ALWAYS AS ROW END HIDDEN NOT NULL,
    PERIOD FOR SYSTEM_TIME (ValidFrom, ValidTo)
) WITH (SYSTEM_VERSIONING = ON (HISTORY_TABLE = dbo.CustomerHistory));
