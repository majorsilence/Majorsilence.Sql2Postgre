-- sql2pg: phase Tables

-- sql2pg:object Table public.audit status=Converted
CREATE TABLE public.audit (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    note varchar(100) NOT NULL
);

-- sql2pg:object Table public.item status=Converted
CREATE TABLE public.item (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    name varchar(50) NOT NULL,
    price numeric(10,2) NOT NULL
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.add_item status=Converted
CREATE PROCEDURE public.add_item(name varchar(50), price numeric(10,2) DEFAULT 0, INOUT id integer DEFAULT NULL, INOUT return_code integer DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_identity numeric(38,0);
BEGIN
    add_item.return_code := 0;
    IF add_item.price < 0 THEN
        add_item.return_code := 1;
        RETURN;
    END IF;
    INSERT INTO public.item (name, price)
    VALUES (add_item.name, add_item.price)
    RETURNING id
    INTO sql2pg_identity;
    add_item.id := CAST(trunc(sql2pg_identity) AS integer);
    add_item.return_code := 0;
    RETURN;
END;
$$;

-- sql2pg:object Procedure public.item_names status=Converted
CREATE FUNCTION public.item_names(max numeric(10,2))
RETURNS TABLE (name varchar(50))
LANGUAGE plpgsql
STABLE
AS $$
#variable_conflict use_column
BEGIN
    RETURN QUERY SELECT CAST(name AS varchar) AS name
        FROM public.item
        WHERE price <= item_names.max;
END;
$$;

-- sql2pg:object Procedure public.item_report status=ConvertedWithWarnings
CREATE PROCEDURE public.item_report(min numeric(10,2), INOUT result_set_1 refcursor DEFAULT NULL, INOUT result_set_2 refcursor DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    OPEN result_set_1 FOR SELECT count(*) AS items
        FROM public.item
        WHERE price >= item_report.min;
    OPEN result_set_2 FOR SELECT id, name
        FROM public.item
        WHERE price >= item_report.min
        ORDER BY id NULLS FIRST;
END;
$$;

-- sql2pg:object Procedure public.items_under status=Converted
CREATE FUNCTION public.items_under(max numeric(10,2))
RETURNS TABLE (id integer, name varchar(50), price numeric(10,2), doubled numeric(18,0), column5 varchar(1))
LANGUAGE plpgsql
STABLE
AS $$
#variable_conflict use_column
BEGIN
    RETURN QUERY SELECT CAST(id AS integer) AS id, CAST(name AS varchar) AS name, CAST(price AS numeric) AS price, CAST(price * 2 AS numeric) AS doubled, CAST('x' AS varchar) AS column5
        FROM public.item
        WHERE price <= items_under.max
        ORDER BY price DESC NULLS LAST;
END;
$$;

-- sql2pg:object Procedure public.cheap_names status=Converted
CREATE FUNCTION public.cheap_names(max numeric(10,2))
RETURNS TABLE (id integer, name varchar(50), price numeric(10,2), doubled numeric(18,0), column5 varchar(1))
LANGUAGE plpgsql
VOLATILE
AS $$
#variable_conflict use_column
BEGIN
    INSERT INTO public.audit (note)
    SELECT *
    FROM public.item_names(max => cheap_names.max);
    RETURN QUERY SELECT CAST(sql2pg_q.c1 AS integer) AS id, CAST(sql2pg_q.c2 AS varchar) AS name, CAST(sql2pg_q.c3 AS numeric) AS price, CAST(sql2pg_q.c4 AS numeric) AS doubled, CAST(sql2pg_q.c5 AS varchar) AS column5
        FROM (SELECT * FROM public.items_under(max => 1)) AS sql2pg_q (c1, c2, c3, c4, c5);
END;
$$;

-- sql2pg:object Procedure public.restock status=ConvertedWithWarnings
CREATE PROCEDURE public.restock(name varchar(50), INOUT result_set_1 refcursor DEFAULT NULL, INOUT result_set_2 refcursor DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    v_id integer;
    v_rc integer;
    sql2pg_arg1 integer;
    sql2pg_arg2 integer;
BEGIN
    COMMIT;
    CALL public.add_item(name => restock.name, price => 5, id => v_id, return_code => v_rc);
    IF v_rc <> 0 THEN
        ROLLBACK;
        RETURN;
    END IF;
    sql2pg_arg1 := v_id;
    CALL public.add_item(name => restock.name, id => sql2pg_arg1, return_code => sql2pg_arg2);
    INSERT INTO public.audit (note)
    VALUES ('restocked ' || restock.name);
    COMMIT;
    CALL public.item_report(min => 0, result_set_1 => restock.result_set_1, result_set_2 => restock.result_set_2);
END;
$$;

-- sql2pg:object Procedure public.top_items status=Converted
CREATE FUNCTION public.top_items()
RETURNS TABLE (name varchar(50), price numeric(10,2))
LANGUAGE plpgsql
STABLE
AS $$
#variable_conflict use_column
BEGIN
    RETURN QUERY SELECT CAST(name AS varchar) AS name, CAST(price AS numeric) AS price
        FROM public.item
        ORDER BY price DESC NULLS LAST
        LIMIT 2;
END;
$$;

-- sql2pg:object Procedure public.unsupported status=Manual
CREATE PROCEDURE public.unsupported()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    /* sql2pg:untranslated S2P5024
    SAVE TRANSACTION before_change;
    */
    /* sql2pg:untranslated S2P5025
    IF @@TRANCOUNT > 1 PRINT 'nested';
    */
    /* sql2pg:untranslated S2P5023
    EXEC sp_rename 'dbo.item', 'items';
    */
    /* sql2pg:untranslated S2P5027
    EXEC dbo.missing_procedure 1;
    */
END;
$$;

-- sql2pg: phase Constraints

-- sql2pg:object Constraint public.audit.audit_pkey status=Converted
ALTER TABLE public.audit ADD CONSTRAINT audit_pkey PRIMARY KEY (id);

-- sql2pg:object Constraint public.item.item_pkey status=Converted
ALTER TABLE public.item ADD CONSTRAINT item_pkey PRIMARY KEY (id);
