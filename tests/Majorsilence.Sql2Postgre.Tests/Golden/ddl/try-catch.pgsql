-- sql2pg: phase Tables

-- sql2pg:object Table public.error_log status=Converted
CREATE TABLE public.error_log (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    number integer,
    message varchar(4000),
    procedure_name varchar(128)
);

-- sql2pg:object Table public.item status=Converted
CREATE TABLE public.item (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    name varchar(50) NOT NULL,
    price numeric(10,2) NOT NULL
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.add_item status=Converted
CREATE PROCEDURE public.add_item(name varchar(50), price numeric(10,2))
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    COMMIT;
    BEGIN
        INSERT INTO public.item (name, price)
        VALUES (add_item.name, add_item.price);
    EXCEPTION
        WHEN OTHERS THEN
            IF -1 <> 0 THEN
                ROLLBACK;
            END IF;
            RAISE NOTICE '%', COALESCE('Unable to add ' || add_item.name, '');
            RAISE;
    END;
    COMMIT;
END;
$$;

-- sql2pg:object Procedure public.half_committed status=Manual
CREATE PROCEDURE public.half_committed()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    COMMIT;
    BEGIN
        INSERT INTO public.item (name, price)
        VALUES ('a', 1);
        /* sql2pg:untranslated S2P5042
        COMMIT;
        */
        INSERT INTO public.item (name, price)
        VALUES ('b', 2);
    EXCEPTION
        WHEN OTHERS THEN
            NULL;
    END;
END;
$$;

-- sql2pg:object Procedure public.reprice status=Converted
CREATE PROCEDURE public.reprice(name varchar(50), price numeric(10,2), INOUT return_code integer DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_error_message text;
    sql2pg_error_sqlstate text;
    sql2pg_error_detail text;
    sql2pg_error_number integer;
BEGIN
    reprice.return_code := 0;
    COMMIT;
    BEGIN
        UPDATE public.item
        SET price = reprice.price
        WHERE name = reprice.name;
        IF reprice.price < 0 THEN
            RAISE EXCEPTION USING MESSAGE = 'negative price', ERRCODE = 'P0001', DETAIL = 'mssql_error=50010';
        END IF;
    EXCEPTION
        WHEN OTHERS THEN
            GET STACKED DIAGNOSTICS sql2pg_error_message = MESSAGE_TEXT, sql2pg_error_sqlstate = RETURNED_SQLSTATE, sql2pg_error_detail = PG_EXCEPTION_DETAIL;
            sql2pg_error_number := CASE WHEN sql2pg_error_sqlstate = 'P0001' AND sql2pg_error_detail LIKE 'mssql\_error=%' THEN CAST(substr(sql2pg_error_detail, 13) AS integer) WHEN sql2pg_error_sqlstate = '23505' THEN 2627 WHEN sql2pg_error_sqlstate = '23503' THEN 547 WHEN sql2pg_error_sqlstate = '23514' THEN 547 WHEN sql2pg_error_sqlstate = '23502' THEN 515 WHEN sql2pg_error_sqlstate = '22012' THEN 8134 WHEN sql2pg_error_sqlstate = '22003' THEN 8115 WHEN sql2pg_error_sqlstate = '22001' THEN 8152 WHEN sql2pg_error_sqlstate = '22P02' THEN 245 WHEN sql2pg_error_sqlstate = '22007' THEN 241 WHEN sql2pg_error_sqlstate = '22008' THEN 242 WHEN sql2pg_error_sqlstate = '40P01' THEN 1205 WHEN sql2pg_error_sqlstate = '40001' THEN 1205 ELSE 50000 END;
            IF 1 > 0 THEN
                ROLLBACK;
            END IF;
            INSERT INTO public.error_log (number, message, procedure_name)
            VALUES (sql2pg_error_number, sql2pg_error_message, 'dbo.reprice');
            reprice.return_code := -1;
            RETURN;
    END;
    COMMIT;
    reprice.return_code := 0;
    RETURN;
END;
$$;

-- sql2pg:object Procedure public.safe_divide status=ConvertedWithWarnings
CREATE FUNCTION public.safe_divide(a integer, b integer)
RETURNS TABLE (result integer, message varchar(4000))
LANGUAGE plpgsql
STABLE
AS $$
#variable_conflict use_column
DECLARE
    v_result integer;
    v_message varchar(4000);
    sql2pg_error_message text;
    sql2pg_error_message_2 text;
BEGIN
    v_message := NULL;
    BEGIN
        v_result := safe_divide.a / safe_divide.b;
    EXCEPTION
        WHEN OTHERS THEN
            GET STACKED DIAGNOSTICS sql2pg_error_message = MESSAGE_TEXT;
            BEGIN
                v_result := safe_divide.a / NULLIF(safe_divide.b, 0);
            EXCEPTION
                WHEN OTHERS THEN
                    GET STACKED DIAGNOSTICS sql2pg_error_message_2 = MESSAGE_TEXT;
                    v_message := sql2pg_error_message_2;
            END;
            v_message := CAST(sql2pg_error_message || ' (line ' || CAST(CAST(NULL AS integer) AS varchar(10)) || ', state ' || CAST(1 AS varchar(10)) || ', severity ' || CAST(16 AS varchar(10)) || ')' AS varchar(4000));
    END;
    RETURN QUERY SELECT CAST(v_result AS integer) AS result, CAST(v_message AS varchar) AS message;
END;
$$;

-- sql2pg:object Procedure public.two_writes status=ConvertedWithWarnings
CREATE PROCEDURE public.two_writes()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    BEGIN
        INSERT INTO public.item (name, price)
        VALUES ('c', 3);
        INSERT INTO public.item (name, price)
        VALUES ('c', 3);
    EXCEPTION
        WHEN OTHERS THEN
            RAISE NOTICE '%', 'second insert failed';
    END;
END;
$$;

-- sql2pg: phase Constraints

-- sql2pg:object Constraint public.error_log.error_log_pkey status=Converted
ALTER TABLE public.error_log ADD CONSTRAINT error_log_pkey PRIMARY KEY (id);

-- sql2pg:object Constraint public.item.item_name_key status=Converted
ALTER TABLE public.item ADD CONSTRAINT item_name_key UNIQUE (name);

-- sql2pg:object Constraint public.item.item_pkey status=Converted
ALTER TABLE public.item ADD CONSTRAINT item_pkey PRIMARY KEY (id);
