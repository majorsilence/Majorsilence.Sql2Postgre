-- sql2pg: phase Types

-- sql2pg:object UserType public.idlist status=Converted
CREATE TYPE public.idlist AS (
    id integer
);

-- sql2pg:object UserType public.orderlinelist status=Converted
CREATE TYPE public.orderlinelist AS (
    orderreference integer,
    itemid integer,
    quantity integer
);

-- sql2pg:object UserType public.orderlist status=Converted
CREATE TYPE public.orderlist AS (
    orderreference integer,
    customerid integer,
    comments varchar(100)
);

-- sql2pg: phase Tables

-- sql2pg:object Table public.orderlines status=Converted
CREATE TABLE public.orderlines (
    orderlineid integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    orderid integer NOT NULL,
    itemid integer NOT NULL,
    quantity integer NOT NULL
);

-- sql2pg:object Table public.orders status=Converted
CREATE TABLE public.orders (
    orderid integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    customerid integer NOT NULL,
    comments varchar(100),
    reference integer NOT NULL
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.insertorders status=ConvertedWithWarnings
CREATE PROCEDURE public.insertorders(orders public.orderlist[], lines public.orderlinelist[], minquantity integer DEFAULT 1, INOUT return_code integer DEFAULT NULL, INOUT result_set refcursor DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    insertorders.return_code := 0;
    IF NOT EXISTS (SELECT 1 FROM unnest(insertorders.orders) AS orders) THEN
        insertorders.return_code := 0;
        RETURN;
    END IF;
    INSERT INTO public.orders (customerid, comments, reference)
    SELECT o.customerid, o.comments, o.orderreference
    FROM unnest(insertorders.orders) AS o
    ORDER BY o.orderreference NULLS FIRST;
    INSERT INTO public.orderlines (orderid, itemid, quantity)
    SELECT d.orderid, l.itemid, l.quantity
    FROM unnest(insertorders.lines) AS l JOIN public.orders AS d ON d.reference = l.orderreference
    WHERE l.quantity >= insertorders.minquantity;
    OPEN result_set FOR SELECT max(orderreference) AS lastreference, (SELECT count(*) FROM unnest(insertorders.lines) AS lines) AS lines
        FROM unnest(insertorders.orders) AS orders;
    insertorders.return_code := 1;
    RETURN;
END;
$$;

-- sql2pg:object Function public.ordersfor status=Converted
CREATE FUNCTION public.ordersfor(ids public.idlist[])
RETURNS TABLE (orderid integer, customerid integer)
LANGUAGE sql
STABLE
AS $$
SELECT o.orderid, o.customerid
FROM public.orders AS o JOIN unnest(ordersfor.ids) AS i ON i.id = o.customerid;
$$;

-- sql2pg:object Procedure public.placeorder status=ConvertedWithWarnings
CREATE PROCEDURE public.placeorder(customer integer, INOUT result_set_1 refcursor DEFAULT NULL, INOUT result_set_2 refcursor DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_arg1 public.orderlist[];
    sql2pg_arg2 public.orderlinelist[];
    sql2pg_arg3 integer;
BEGIN
    DROP TABLE IF EXISTS tv_placeorder_o;
    CREATE TEMP TABLE tv_placeorder_o (
        orderreference integer,
        customerid integer,
        comments varchar(100)
    );
    DROP TABLE IF EXISTS tv_placeorder_l;
    CREATE TEMP TABLE tv_placeorder_l (
        orderreference integer,
        itemid integer,
        quantity integer
    );
    DROP TABLE IF EXISTS tv_placeorder_ids;
    CREATE TEMP TABLE tv_placeorder_ids (
        id integer
    );
    INSERT INTO tv_placeorder_o (orderreference, customerid, comments)
    VALUES (1, placeorder.customer, 'first');
    INSERT INTO tv_placeorder_l (orderreference, itemid, quantity)
    VALUES (1, 10, 2), (1, 11, 1);
    sql2pg_arg1 := ARRAY(SELECT CAST(ROW(orderreference, customerid, comments) AS public.orderlist) FROM tv_placeorder_o);
    sql2pg_arg2 := ARRAY(SELECT CAST(ROW(orderreference, itemid, quantity) AS public.orderlinelist) FROM tv_placeorder_l);
    CALL public.insertorders(orders => sql2pg_arg1, lines => sql2pg_arg2, return_code => sql2pg_arg3, result_set => placeorder.result_set_1);
    INSERT INTO tv_placeorder_ids (id)
    VALUES (placeorder.customer);
    OPEN result_set_2 FOR SELECT orderid
        FROM public.ordersfor(ARRAY(SELECT CAST(ROW(id) AS public.idlist) FROM tv_placeorder_ids)) AS ordersfor
        ORDER BY orderid NULLS FIRST;
END;
$$;

-- sql2pg: phase Constraints

-- sql2pg:object Constraint public.orderlines.orderlines_pkey status=Converted
ALTER TABLE public.orderlines ADD CONSTRAINT orderlines_pkey PRIMARY KEY (orderlineid);

-- sql2pg:object Constraint public.orders.orders_pkey status=Converted
ALTER TABLE public.orders ADD CONSTRAINT orders_pkey PRIMARY KEY (orderid);
