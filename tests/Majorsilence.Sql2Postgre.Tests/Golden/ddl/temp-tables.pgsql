-- sql2pg: phase Tables

-- sql2pg:object Table public.audit status=Converted
CREATE TABLE public.audit (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    note varchar(100) NOT NULL
);

-- sql2pg:object Table public.item status=Converted
CREATE TABLE public.item (
    id integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    name varchar(50) NOT NULL,
    price numeric(10,2) NOT NULL
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.cheap_items status=Converted
CREATE FUNCTION public.cheap_items(max numeric(10,2))
RETURNS TABLE (name varchar(50), price numeric(10,2))
LANGUAGE plpgsql
VOLATILE
AS $$
#variable_conflict use_column
BEGIN
    DROP TABLE IF EXISTS cheap;
    CREATE TEMP TABLE cheap (
        id integer NOT NULL,
        name varchar(50) NOT NULL,
        price numeric(10,2)
    );
    ALTER TABLE cheap ADD CONSTRAINT cheap_pkey PRIMARY KEY (id);
    ALTER TABLE cheap ADD CONSTRAINT cheap_check1 CHECK (price >= 0);
    CREATE INDEX ON cheap (name);
    INSERT INTO cheap (id, name, price)
    SELECT id, name, price
    FROM public.item
    WHERE price <= cheap_items.max;
    CREATE INDEX ON cheap (price DESC);
    IF NOT EXISTS (SELECT 1 FROM cheap) THEN
        DROP TABLE IF EXISTS cheap;
        RETURN;
    END IF;
    RETURN QUERY SELECT CAST(c.name AS varchar) AS name, CAST(c.price AS numeric) AS price
        FROM cheap AS c
        ORDER BY c.price NULLS FIRST;
    DROP TABLE IF EXISTS cheap;
END;
$$;

-- sql2pg:object Procedure public.copy_names status=ConvertedWithWarnings
CREATE PROCEDURE public.copy_names(INOUT return_code integer DEFAULT NULL)
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    copy_names.return_code := 0;
    DROP TABLE IF EXISTS tv_copy_names_log;
    CREATE TEMP TABLE tv_copy_names_log (
        note varchar(100)
    );
    DROP TABLE IF EXISTS names;
    CREATE TEMP TABLE names AS
    SELECT id, name
    FROM public.item;
    TRUNCATE TABLE public.audit RESTART IDENTITY;
    INSERT INTO public.audit (note)
    SELECT name
    FROM names;
    IF CAST(CAST(to_regclass('pg_temp.names') AS oid) AS integer) IS NOT NULL THEN
        DROP TABLE names;
    END IF;
    INSERT INTO tv_copy_names_log (note)
    VALUES ('copied');
    ROLLBACK;
    IF to_regclass('pg_temp.tv_copy_names_log') IS NULL THEN
        DROP TABLE IF EXISTS tv_copy_names_log;
        CREATE TEMP TABLE tv_copy_names_log (
            note varchar(100)
        );
    END IF;
    copy_names.return_code := 1;
    DROP TABLE IF EXISTS names;
    DROP TABLE IF EXISTS tv_copy_names_log;
    RETURN;
END;
$$;

-- sql2pg:object Function public.item_count status=Converted
CREATE FUNCTION public.item_count()
RETURNS integer
LANGUAGE plpgsql
VOLATILE
AS $$
#variable_conflict use_column
BEGIN
    DROP TABLE IF EXISTS tv_item_count_t;
    CREATE TEMP TABLE tv_item_count_t (
        id integer
    ) ON COMMIT DROP;
    INSERT INTO tv_item_count_t (id)
    SELECT id
    FROM public.item;
    RETURN (SELECT count(*) FROM tv_item_count_t);
END;
$$;

-- sql2pg:object Procedure public.price_changes status=Converted
CREATE FUNCTION public.price_changes(rise numeric(10,2))
RETURNS TABLE (id integer, old_price numeric(10,2), new_price numeric(10,2))
LANGUAGE plpgsql
VOLATILE
AS $$
#variable_conflict use_column
BEGIN
    DROP TABLE IF EXISTS tv_price_changes_changes;
    CREATE TEMP TABLE tv_price_changes_changes (
        seq integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1),
        id integer,
        old_price numeric(10,2),
        new_price numeric(10,2)
    );
    WITH sql2pg_output (c1, c2, c3) AS (UPDATE public.item
    SET price = price + price_changes.rise
    WHERE price < 5
    RETURNING new.id, old.price, new.price)
    INSERT INTO tv_price_changes_changes (id, old_price, new_price)
    SELECT c1, c2, c3
    FROM sql2pg_output;
    RETURN QUERY SELECT CAST(id AS integer) AS id, CAST(old_price AS numeric) AS old_price, CAST(new_price AS numeric) AS new_price
        FROM tv_price_changes_changes
        ORDER BY seq NULLS FIRST;
    DROP TABLE IF EXISTS tv_price_changes_changes;
END;
$$;

-- sql2pg:object Procedure public.shared status=Manual
CREATE PROCEDURE public.shared()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_arg1 integer;
BEGIN
    /* sql2pg:untranslated S2P5030
    CREATE TABLE ##everyone (id int);
    */
    DROP TABLE IF EXISTS names;
    CREATE TEMP TABLE names (
        id integer
    );
    CALL public.copy_names(return_code => sql2pg_arg1);
    DROP TABLE IF EXISTS names;
END;
$$;

