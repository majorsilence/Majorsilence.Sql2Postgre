-- sql2pg: phase Tables

-- sql2pg:object Table public.errorlog status=Converted
CREATE TABLE public.errorlog (
    errorlogid integer GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1) NOT NULL,
    errornumber integer,
    errormessage varchar(4000),
    errorprocedure varchar(126)
);

-- sql2pg: phase Code
SET check_function_bodies = off;

-- sql2pg:object Procedure public.logerror status=Converted
CREATE PROCEDURE public.logerror()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
BEGIN
    IF CAST(NULLIF(current_setting('sql2pg.error_number', true), '') AS integer) IS NULL THEN
        RETURN;
    END IF;
    INSERT INTO public.errorlog (errornumber, errormessage, errorprocedure)
    VALUES (CAST(NULLIF(current_setting('sql2pg.error_number', true), '') AS integer), NULLIF(current_setting('sql2pg.error_message', true), ''), NULLIF(current_setting('sql2pg.error_procedure', true), ''));
END;
$$;

-- sql2pg:object Procedure public.work status=Converted
CREATE PROCEDURE public.work()
LANGUAGE plpgsql
AS $$
#variable_conflict use_column
DECLARE
    sql2pg_error_message text;
    sql2pg_error_sqlstate text;
    sql2pg_error_detail text;
    sql2pg_error_number integer;
BEGIN
    COMMIT;
    BEGIN
        UPDATE public.errorlog
        SET errornumber = errornumber + 1;
    EXCEPTION
        WHEN OTHERS THEN
            GET STACKED DIAGNOSTICS sql2pg_error_message = MESSAGE_TEXT, sql2pg_error_sqlstate = RETURNED_SQLSTATE, sql2pg_error_detail = PG_EXCEPTION_DETAIL;
            sql2pg_error_number := CASE WHEN sql2pg_error_sqlstate = 'P0001' AND sql2pg_error_detail LIKE 'mssql\_error=%' THEN CAST(substr(sql2pg_error_detail, 13) AS integer) WHEN sql2pg_error_sqlstate = '23505' THEN 2627 WHEN sql2pg_error_sqlstate = '23503' THEN 547 WHEN sql2pg_error_sqlstate = '23514' THEN 547 WHEN sql2pg_error_sqlstate = '23502' THEN 515 WHEN sql2pg_error_sqlstate = '22012' THEN 8134 WHEN sql2pg_error_sqlstate = '22003' THEN 8115 WHEN sql2pg_error_sqlstate = '22001' THEN 8152 WHEN sql2pg_error_sqlstate = '22P02' THEN 245 WHEN sql2pg_error_sqlstate = '22007' THEN 241 WHEN sql2pg_error_sqlstate = '22008' THEN 242 WHEN sql2pg_error_sqlstate = '40P01' THEN 1205 WHEN sql2pg_error_sqlstate = '40001' THEN 1205 ELSE 50000 END;
            PERFORM set_config('sql2pg.error_number', CAST(sql2pg_error_number AS text), false), set_config('sql2pg.error_message', sql2pg_error_message, false), set_config('sql2pg.error_procedure', 'dbo.Work', false);
            IF 1 > 0 THEN
                ROLLBACK;
                PERFORM set_config('sql2pg.error_number', CAST(sql2pg_error_number AS text), false), set_config('sql2pg.error_message', sql2pg_error_message, false), set_config('sql2pg.error_procedure', 'dbo.Work', false);
            END IF;
            CALL public.logerror();
            RAISE;
            PERFORM set_config('sql2pg.error_number', '', false), set_config('sql2pg.error_message', '', false), set_config('sql2pg.error_procedure', '', false);
    END;
    COMMIT;
END;
$$;

-- sql2pg: phase Constraints

-- sql2pg:object Constraint public.errorlog.errorlog_pkey status=Converted
ALTER TABLE public.errorlog ADD CONSTRAINT errorlog_pkey PRIMARY KEY (errorlogid);
