CREATE TABLE dbo.t (
    id int NOT NULL,
    code varchar(10) NOT NULL,
    qty int NOT NULL,
    CONSTRAINT uq_t_code UNIQUE (code),
    UNIQUE (id, qty),
    CONSTRAINT ck_t_qty CHECK (qty > 0),
    CHECK (code <> '')
);
CREATE TABLE dbo.jobs (job_id int NOT NULL, min_lvl int NOT NULL CHECK (min_lvl >= 10), max_lvl int NOT NULL CHECK (max_lvl <= 250));
