Imports System.Data
Imports Dapper
Imports Npgsql

Public NotInheritable Class OrderStore
    Private Const ActiveCustomers As String = "SELECT customer_id, name FROM shop.customer WHERE is_active = true ORDER BY name NULLS FIRST LIMIT 10"
    Private ReadOnly _connectionString As String

    Public Sub New(connectionString As String)
        _connectionString = connectionString
    End Sub

    Public Function Active() As IEnumerable(Of String)
        Using connection As New NpgsqlConnection(_connectionString)
            Return connection.Query(Of String)(ActiveCustomers)
        End Using
    End Function

    Public Function Count() As Integer
        Using connection As New NpgsqlConnection(_connectionString)
            connection.Open()
            Using command As New NpgsqlCommand("SELECT CAST(count(*) AS integer) FROM shop.customer WHERE COALESCE(email, '') <> ''", connection)
                Return CInt(command.ExecuteScalar())
            End Using
        End Using
    End Function

    Public Function Add(customerId As Integer, total As Decimal) As Long
        Using connection As New NpgsqlConnection(_connectionString)
            connection.Open()
            Dim command = connection.CreateCommand()
            command.CommandText = "INSERT INTO shop.""order"" (customer_id, order_date, total) VALUES (@customerId, localtimestamp, @total) RETURNING CAST(order_id AS numeric)"
            command.Parameters.AddWithValue("@customerId", customerId)
            command.Parameters.AddWithValue("@total", total)
            Return CLng(command.ExecuteScalar())
        End Using
    End Function
End Class
