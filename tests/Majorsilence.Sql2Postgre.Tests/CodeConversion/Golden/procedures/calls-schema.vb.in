Imports System.Data
Imports Microsoft.Data.SqlClient

Public NotInheritable Class Orders
    Private ReadOnly _connection As SqlConnection

    Public Sub New(connection As SqlConnection)
        _connection = connection
    End Sub

    Public Function Add(customerId As Integer) As Long
        Using command As New SqlCommand("shop.add_order", _connection) With {.CommandType = CommandType.StoredProcedure}
            command.Parameters.AddWithValue("@customer_id", customerId)
            Dim id = command.Parameters.Add("@order_id", SqlDbType.BigInt)
            id.Direction = ParameterDirection.Output
            command.ExecuteNonQuery()
            Return CLng(id.Value)
        End Using
    End Function
End Class
