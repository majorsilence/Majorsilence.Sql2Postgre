<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Majorsilence.Sql2Postgre.Model\Majorsilence.Sql2Postgre.Model.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Sql2Postgre.SqlServer\Majorsilence.Sql2Postgre.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Sql2Postgre.Translation\Majorsilence.Sql2Postgre.Translation.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Sql2Postgre.Postgres\Majorsilence.Sql2Postgre.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Sql2Postgre.Data\Majorsilence.Sql2Postgre.Data.csproj" />
    <ProjectReference Include="..\..\src\Majorsilence.Sql2Postgre.Compat\Majorsilence.Sql2Postgre.Compat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\fixtures\**\*.sql" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Queries\**\*.sql;Queries\Baselines.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The container fixtures are shared with the integration tests, as linked source. -->
  <ItemGroup>
    <Compile Include="../Majorsilence.Sql2Postgre.Integration.Tests/Infrastructure/*.cs" LinkBase="Infrastructure" />
    <Compile Include="../Majorsilence.Sql2Postgre.Integration.Tests/EnginesTeardown.cs" Link="EnginesTeardown.cs" />
  </ItemGroup>

</Project>
